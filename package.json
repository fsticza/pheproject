{
  "name": "pheproject",
  "version": "1.0.0",
  "description": "PHE project site",
  "author": "Ferenc Sticza",
  "private": true,
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "nuxi-ng dev",
    "build": "nuxi-ng build",
    "imagemin": "node ./imagemin.js",
    "prestart": "node ./scripts/ensure-production-output.mjs",
    "start": "nuxi-ng preview",
    "generate": "nuxi-ng generate",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "test": "ava",
    "smoke:routes": "node ./scripts/smoke-routes.mjs",
    "monitor:runtime": "node ./scripts/monitor-runtime.mjs",
    "preflight:cutover": "node ./scripts/cutover-preflight.mjs",
    "postdeploy:verify": "node ./scripts/postdeploy-verify.mjs",
    "dev:bridge": "nuxt2 dev",
    "dev:nuxt": "nuxi-ng dev",
    "build:bridge": "nuxt2 build",
    "build:nuxt": "nuxi-ng build",
    "start:nuxt": "nuxi-ng preview",
    "generate:bridge": "nuxt2 generate"
  },
  "dependencies": {
    "@nuxtjs/markdownit": "^1.2.7",
    "bootstrap": "^4.4.1",
    "core-js": "^3.49.0",
    "cross-env": "^5.2.0",
    "defu": "^6.1.4",
    "hookable": "5.5.3",
    "koa": "^2.11.0",
    "markdown-it": "^14.1.1",
    "nuxt": "^4.4.6",
    "sass": "^1.62.1"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config": "^1.0.1",
    "@nuxtjs/eslint-module": "^1.0.0",
    "@vue/test-utils": "^2.4.10",
    "ava": "^8.0.1",
    "babel-eslint": "^10.0.1",
    "babel-plugin-module-resolver": "^3.2.0",
    "browser-env": "^3.3.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-nuxt": "^0.5.0",
    "eslint-plugin-prettier": "^3.1.2",
    "imagemin": "^6.0.0",
    "imagemin-jpegtran": "^6.0.0",
    "imagemin-mozjpeg": "^8.0.0",
    "imagemin-pngquant": "^6.0.0",
    "nodemon": "^1.19.4",
    "nuxi": "^3.35.2",
    "prettier": "^1.19.1",
    "require-extension-hooks": "^0.3.3",
    "require-extension-hooks-babel": "^1.0.0",
    "require-extension-hooks-vue": "^2.0.0",
    "sass-loader": "^10.4.1",
    "vue": "^3.5.34"
  },
  "ava": {
    "sources": [
      "**/*.{js,vue}"
    ],
    "files": [
      "test/specs/**/*"
    ],
    "tap": true,
    "verbose": true
  }
}
